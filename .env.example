# DeepScript Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is listed in .gitignore.

# LLM Providers (at least one required for LLM-based analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# NVIDIA NIM (optional — for NVIDIA-hosted models)
NVIDIA_API_KEY=your-nvidia-api-key-here

# Microsoft 365 Integration (optional — for calendar/transcript import)
MS365_CLI_CLIENT_ID=your-ms365-client-id-here
MS365_CLI_TENANT_ID=your-ms365-tenant-id-here

# Fireflies Integration (optional — for Fireflies transcript import)
FIREFLIES_API_KEY=your-fireflies-api-key-here